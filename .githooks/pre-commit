#!/bin/sh
# ステージされた C++ ファイルを clang-format で整形して再 stage する。
# 有効化と設計の理由は docs/current/toolchain.md を参照。

set -e

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.cpp' '*.hpp')
[ -z "$files" ] && exit 0

if command -v mise > /dev/null 2>&1; then
    fmt="mise exec -- clang-format"
elif command -v clang-format > /dev/null 2>&1; then
    fmt="clang-format"
else
    echo "pre-commit: clang-format が見つかりません（mise install を実行してください）。" >&2
    exit 1
fi

echo "$files" | while IFS= read -r f; do
    [ -f "$f" ] || continue
    $fmt -i -- "$f"
    git add -- "$f"
done
